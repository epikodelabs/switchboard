<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <PackageId>EpikodeLabs.Switchboard.Templates</PackageId>
    <PackageVersion>1.0.1</PackageVersion>
    <Title>Switchboard server templates</Title>
    <Description>ASP.NET Core server template for Switchboard protected frame delivery.</Description>
    <Authors>EpikodeLabs</Authors>
    <PackageType>Template</PackageType>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <NoBuild>true</NoBuild>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="../template/**/*" Pack="true" PackagePath="content/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
